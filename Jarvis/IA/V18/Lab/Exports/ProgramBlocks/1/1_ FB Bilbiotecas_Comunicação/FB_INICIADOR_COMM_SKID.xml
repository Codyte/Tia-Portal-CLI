  <LineComment Inserted="true" NoClosingBracket="false" UId="21">
    <Text UId="22"> // =======================
// LÓGICA PRINCIPAL
// =======================
IF not #HABILITA THEN
    #tWait_Ctu.IN := FALSE;
    #tWait_Busy.IN := FALSE;
    RETURN;
END_IF;


// =======================
// STATUS VÁLIDOS
// =======================
#Status_OK := (#STATUS_WORD = 16#0000) OR
(#STATUS_WORD = 16#0001) OR
(#STATUS_WORD = 16#7000) OR
(#STATUS_WORD = 16#7004) OR
(#STATUS_WORD = 16#7005) OR
(#STATUS_WORD = 16#7006);


// =======================
// MONITORA BUSY
// =======================
#tWait_Busy(IN := #BUSY,   PT := #tBUSY);

// =======================
// PRIMEIRA EXECUÇÃO
// =======================
IF #FIRST_RUN THEN
    #index := 1;
    #Tcom_IP_4.ID := INT_TO_WORD(#index);
    #FIRST_RUN := FALSE;
END_IF;


// =======================
// CONDIÇÃO DE SUCESSO
// =======================
IF #DONE AND #Status_OK AND NOT #tWait_Busy.Q THEN
    // Comunicação consolidada
    #index := 1;
    #Tcom_IP_4.ID := INT_TO_WORD(#index);
    
    #tWait_Ctu.IN := FALSE;
    #tWait_Busy.IN := FALSE;
    #ERROR := FALSE;
    
    // =======================
    // MODO SCAN 
    // =======================
ELSE
    #ERROR := TRUE;
    
    // Só entra em varredura se BUSY travou ou DONE não confirmou
    IF #tWait_Busy.Q OR NOT #DONE THEN
        #tWait_Ctu(IN := TRUE,  PT := #tCTU);
        #tWait_Ctu_1(IN := NOT #Conected,
                   PT := #tCTU);
      #Conected := #tWait_Ctu_1.Q;
        
        IF #tWait_Ctu.Q THEN
            #index := #index + 1;
            
            IF #index &gt; #id_Max THEN
                #index := 1;
            END_IF;
           
            #Tcom_IP_4.ID := INT_TO_WORD(#index);
            #tWait_Ctu.IN := FALSE; // rearma ciclo
            
        END_IF;
        
        #tWait_Ctu_1.IN := FALSE; // rearma ciclo
    END_IF;
END_IF;
</Text>
  </LineComment>
</StructuredText></NetworkSource>
