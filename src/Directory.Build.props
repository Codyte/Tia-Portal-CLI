<Project>

  <!-- Versão única dos 3 projetos. Bump aqui, entrada no CHANGELOG.md, tag vX.Y.Z.
       O verbo de versão do CLI lê o InformationalVersion desta propriedade. -->
  <PropertyGroup>
    <Version>2.0.0</Version>
    <Company>Codyte</Company>
    <Product>tia-cli</Product>
    <Copyright>MIT</Copyright>
    <RepositoryUrl>https://github.com/Codyte/Tia-Portal-CLI</RepositoryUrl>
  </PropertyGroup>

</Project>
