<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Siemens DLLs are compile-time only; at runtime they resolve from the TIA install (see Program.cs).
         V21+ split the monolithic Siemens.Engineering.dll into Base/Step7/WinCCUnified. -->
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>..\..\lib\Siemens.Engineering.Base.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.Step7">
      <HintPath>..\..\lib\Siemens.Engineering.Step7.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.WinCCUnified">
      <HintPath>..\..\lib\Siemens.Engineering.WinCCUnified.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Startdrive carries the SINAMICS object model: drive objects, parameters and telegrams.
         Telegrams are not catalog submodules you plug — they have their own TelegramComposition. -->
    <Reference Include="Siemens.Engineering.Startdrive">
      <HintPath>..\..\lib\Siemens.Engineering.Startdrive.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- S7-PLCSIM Advanced: PLC virtual. Não é do Openness (vem em Common Files\Siemens\PLCSIMADV\API),
         então o resolver de runtime do Program.cs, que só procura Siemens.Engineering.*, não a acha —
         esta copia junto do exe (Private=true). init.ps1 põe a DLL em lib/. -->
    <Reference Include="Siemens.Simatic.Simulation.Runtime.Api.x64">
      <HintPath>..\..\lib\Siemens.Simatic.Simulation.Runtime.Api.x64.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
